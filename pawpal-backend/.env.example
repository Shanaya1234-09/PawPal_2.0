PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./pawpal.db
APP_TZ=Asia/Kolkata
# Comma-separated origins, or leave empty to allow any (fine for local dev)
CORS_ORIGIN=
# Optional: serve the frontend folder from the same server
FRONTEND_DIR=
# Optional: enables the live assistant. Without it, a built-in triage script answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
